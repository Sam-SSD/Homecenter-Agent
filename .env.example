# =============================================================================
#  LLAVES DE GEMINI  -- pega las tuyas aqui
# =============================================================================
# Opcion A: todas en una linea, separadas por coma. La primera es la principal,
# las siguientes son fallback: se usan si la anterior falla, se queda sin cuota
# (429) o resulta invalida.
GEMINI_API_KEYS=

# Opcion B: numeradas, mas comodo para agregar y quitar sin tocar comas.
# Se combinan con la Opcion A y se deduplican automaticamente.
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=

# =============================================================================
#  MODELOS  -- cadena de fallback, en orden de preferencia
# =============================================================================
# Si el primero no existe o no esta habilitado, pasa al siguiente.
# Corre esto para ver los identificadores exactos que soporta TU llave:
#     python -m src.llm --modelos
# Ojo: Gemini 2.0 se apago el 1-jun-2026. Ya existen 3.5 y 3.6 Flash.
GEMINI_MODELOS=gemini-2.5-flash

# Segundos que una llave queda enfriando tras un 429 antes de reintentarla
LLM_COOLDOWN_S=60

# =============================================================================
#  PROVEEDOR
# =============================================================================
LLM_PROVEEDOR=gemini

# Para volver a Anthropic sin tocar codigo: cambia la linea de arriba a
# "anthropic" y descomenta estas dos.
# ANTHROPIC_API_KEY=
# MODELO=claude-sonnet-5

# =============================================================================
#  DATOS
# =============================================================================
# Descomenta para desactivar validar_en_vivo y usar solo el snapshot del cache.
# Util si la red del evento bloquea homecenter.com.co.
# MODO_OFFLINE=1
