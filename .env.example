# ---- Gemini (proveedor por defecto) ----
# Varias llaves separadas por coma: se rotan automaticamente si una falla,
# se agota la cuota (429) o es invalida.
GEMINI_API_KEYS=llave1,llave2,llave3

# Cadena de modelos de fallback. Si el primero no existe pasa al siguiente.
# Corre `python -m src.llm --modelos` para ver que soporta tu llave.
GEMINI_MODELOS=gemini-2.5-flash

# Segundos que una llave queda enfriando tras un 429
LLM_COOLDOWN_S=60

# ---- alternativa ----
LLM_PROVEEDOR=gemini
# LLM_PROVEEDOR=anthropic
# ANTHROPIC_API_KEY=
# MODELO=claude-sonnet-5

# ---- datos ----
# MODO_OFFLINE=1   # desactiva validar_en_vivo y usa solo el snapshot
